# Merged onto busybox's own defconfig by scripts/build-assets.sh (same
# merge_config.sh mechanism as scripts/kernel-fragment.config). The only
# thing we need beyond defconfig: a single static binary with zero
# runtime library dependencies, so the rootfs image can be just that
# one file plus symlinks -- no .so chasing.
CONFIG_STATIC=y

# tc.c reaches into linux/pkt_sched.h's CBQ structs directly, which
# current kernel-headers no longer ship -- and we have no use for tc
# anyway (see below).
# CONFIG_TC is not set
