# Merged onto x86_64_defconfig by scripts/build/assets.sh (via the
# kernel's own scripts/kconfig/merge_config.sh) inside the cella-build
# toolbox. Only the options cella's boot path actually needs beyond
# defconfig's own -- everything else (including ACPI/PCI, which stay
# enabled) comes from defconfig unmodified. The kernel copes fine with
# ACPI/PCI compiled in but no tables/buses present -- Firecracker's own
# CI kernels are built the same way, and cella boots with pci=off on
# the cmdline regardless.
#
# CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES is the one that matters most: it's
# what lets virtio_mmio.device=SIZE@ADDR:IRQ on the kernel command line
# stand in for the ACPI/devicetree discovery a firmware-booted guest
# would normally get (see devices/virtio/mmio.rs).
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EXT4_FS=y
# CONFIG_BLK_DEV_INITRD is not set

# /dev is populated automatically before init runs -- our rootfs (see
# scripts/build/rootfs.sh) creates no device nodes of its own.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Configures the interface from the ip= cmdline param entirely in the
# kernel -- our init does nothing network-related (see net.sh), and
# ICMP replies are handled in-kernel too, no userspace daemon needed.
# Static "ip=ADDR::GW:MASK..." parsing is part of CONFIG_IP_PNP itself;
# its sub-options (IP_PNP_DHCP/BOOTP/RARP) are the autoconfiguration
# protocols, and we want none of them. There is no CONFIG_IP_PNP_STATIC
# symbol in the kernel at all -- this fragment carried that line for a
# while and it never did anything, which is precisely the class of bug
# `make kernel-config-check` now catches.
CONFIG_IP_PNP=y

# No IPv6: the guest carries no code nobody chose (necessity, not
# cost). Under the total membrane the stack's own chatter -- router
# solicitations, MLD reports -- would park and freeze the machine on
# frames no resident sent; ipv6.disable=1 stays in DEFAULT_BASE_ARGS
# as the VMM-wide floor for foreign kernels, and this line governs
# the goldens. The L2-park law keeps its proof regardless: ARP is
# the in-guest representative, and the unit tests carry the exotic
# ethertypes.
# CONFIG_IPV6 is not set

# The guest has no RTC to read: cella emulates no ports 0x70/0x71, and
# unhandled PIO reads return 0xff (see vcpu.rs::dispatch), so the
# mc146818 "update in progress" bit never clears and every read spins
# out its full mc146818_get_time(.., 1000) timeout. Two independent
# callers do that on every boot, and between them they were ~4.0s of a
# 5.228s boot -- measured, see probes/wallclock and its commit:
#
#   CONFIG_PM_TRACE_RTC   drivers/base/power/trace.c's read_magic_time,
#                         ~1.99s, prints "PM: Unable to read current
#                         time from RTC". It stores a marker in CMOS
#                         across reboots to debug suspend/resume hangs
#                         -- of no use whatsoever to a microVM.
#   CONFIG_RTC_DRV_CMOS   the rtc_cmos probe's mc146818_does_rtc_work,
#                         ~2.01s, prints "rtc_cmos: broken or not
#                         accessible".
#
# Nothing depends on either. The guest's wall clock comes from kvmclock:
# kvmclock_init installs kvm_get_wallclock as x86_platform.get_wallclock
# regardless of the RTC, CONFIG_RTC_HCTOSYS is already off, and
# probes/wallclock confirms it empirically -- the guest's clock was
# already correct (3s drift, i.e. boot time) while both of these were
# failing. This is a boot-time change, not a correctness fix.
# CONFIG_PM_TRACE_RTC is not set
# CONFIG_RTC_DRV_CMOS is not set

# Everything below is defconfig inheritance that this guest has no use
# for. The test applied here is "does cella's guest need this?", not
# "does it show up in a boot profile" -- unneeded drivers are surface
# area and log noise whether or not they cost milliseconds. The guest
# has exactly four things: virtio-blk, virtio-net, an 8250 serial
# console, and an ext4 root. Nothing here serves any of them.
#
# md was the visible offender -- it scans for RAID arrays on every boot
# ("md: Autodetecting RAID arrays") across a single virtio-blk device
# that will never be part of one. Disabling the menu takes device-mapper
# with it, which is equally unused.
# CONFIG_MD is not set

# No sound device is emulated, so ALSA probes for hardware that cannot
# exist ("ALSA device list: No soundcards found").
# CONFIG_SOUND is not set

# CONFIG_VT and CONFIG_INPUT below both have prompts gated on EXPERT
# ("bool ... if EXPERT"): without it they are not user-settable, so they
# silently keep their defaults no matter what this fragment asks for --
# which is exactly what happened on the first attempt at this trim.
# EXPERT only unhides prompts; it changes no values by itself.
CONFIG_EXPERT=y

# No PS/2 controller is emulated either ("i8042: No controller found"),
# and with no serio bus there is no keyboard or mouse to attach, so the
# whole input stack is dead weight.
#
# CONFIG_VT goes with it, and to be explicit about what that is NOT:
# the serial console stays. CONFIG_SERIAL_8250/_CONSOLE above are
# required and untouched -- the guest boots console=ttyS0, every log
# line leaves through the 8250 UART into cella's serial device and onto
# stdout, and that is the only channel out of the guest (it is what
# smoke-boot greps and what both probes read). CONFIG_VT is the
# *virtual terminal* layer -- tty0, the in-kernel VGA text console and
# its keyboard -- which would render to a screen cella does not give
# the guest.
# CONFIG_SERIO is not set
# CONFIG_INPUT is not set
# CONFIG_VT is not set

# No display of any kind: no framebuffer (already off in defconfig), no
# DRM, no AGP bridge -- there is no graphics device on the bus and no
# bus to put one on (cella boots with pci=off).
# CONFIG_DRM is not set
# CONFIG_AGP is not set

# No USB host controller is emulated, so the entire USB stack has
# nothing to enumerate.
# CONFIG_USB_SUPPORT is not set

# Three things must keep working, and everything above and below is
# chosen against that list: TIME (kvmclock -- CONFIG_KVM_GUEST,
# CONFIG_PARAVIRT_CLOCK, CONFIG_X86_TSC, all inherited from defconfig
# and deliberately untouched), RNG, and NETWORK (CONFIG_VIRTIO_NET plus
# the CONFIG_IP_PNP static configuration above). Anything not needed by
# one of those three, or by the virtio-blk/ext4 root and the serial
# console, is fair game regardless of what it costs.
#
# RNG specifically does not need the hwrng framework: the guest's CRNG
# is seeded from RDRAND at [0.044s] ("random: crng init done"), and
# CONFIG_HW_RANDOM is only the bus for hwrng *devices* -- cella emulates
# none, and CONFIG_HW_RANDOM_VIRTIO is already off. Adding a virtio-rng
# device later means turning both back on; until then this is a driver
# framework with nothing to drive. (CONFIG_RANDOM_TRUST_CPU is not
# listed because the symbol no longer exists in 6.18 -- trusting the CPU
# RNG is now the random.trust_cpu boot parameter.)
# CONFIG_HW_RANDOM is not set

# Network means virtio-net and nothing else. CONFIG_VIRTIO_NET depends
# only on CONFIG_VIRTIO and lives outside the ETHERNET menu, so the
# per-vendor NIC drivers can go without touching it -- there is no PCI
# bus for any of them to find hardware on. Wireless likewise: no device,
# no bus, no use for the stack or for rfkill.
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
# CONFIG_RFKILL is not set
