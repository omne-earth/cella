# The kernel config for dist/bzImage-nested: the canonical fragment,
# plus a KVM host stack, so that a cella guest can run cella itself.
# Only the nested targets use this kernel. The canonical dist/bzImage
# does not contain these options: a guest that does not host guests
# does not need a hypervisor (see kernel-fragment.config for the
# necessity rule).
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
# The www variant gives the inner cella a TAP inside the outer guest.
# cella creates the interface itself (TUNSETIFF on /dev/net/tun), thus
# the guest needs the tun driver and nothing from userspace.
CONFIG_TUN=y
# The in-guest verbs run the same bwrap jail as the host. The jail
# unshares the user, pid, ipc, uts, and cgroup namespaces.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
