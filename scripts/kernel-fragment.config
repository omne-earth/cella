# Merged onto x86_64_defconfig by scripts/build-assets.sh (via the
# kernel's own scripts/kconfig/merge_config.sh) inside the cella-build
# toolbox. Only the options cella's boot path actually needs beyond
# defconfig's own -- everything else (including ACPI/PCI, which stay
# enabled) comes from defconfig unmodified. The kernel copes fine with
# ACPI/PCI compiled in but no tables/buses present -- Firecracker's own
# CI kernels are built the same way, and cella boots with pci=off on
# the cmdline regardless.
#
# CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES is the one that matters most: it's
# what lets virtio_mmio.device=SIZE@ADDR:IRQ on the kernel command line
# stand in for the ACPI/devicetree discovery a firmware-booted guest
# would normally get (see devices/virtio/mmio.rs).
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EXT4_FS=y
# CONFIG_BLK_DEV_INITRD is not set

# /dev is populated automatically before init runs -- our rootfs (see
# scripts/rootfs-init.sh) creates no device nodes of its own.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Configures the interface from the ip= cmdline param entirely in the
# kernel -- our init does nothing network-related (see net.sh), and
# ICMP replies are handled in-kernel too, no userspace daemon needed.
CONFIG_IP_PNP=y
CONFIG_IP_PNP_STATIC=y
