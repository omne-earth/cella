/*
 * Reference sketch only -- NOT built or installed by anything in this
 * repo. Illustrates the policy shape discussed in the design: a
 * dedicated domain that can touch /dev/kvm and the TAP device, and an
 * image type for freeze-image directories so a compromised cella
 * can't read other users' or other VMs' frozen state.
 *
 * To actually use this: install selinux-policy-devel, adjust paths for
 * your system, `make -f /usr/share/selinux/devel/Makefile`, then
 * `semodule -i cella.pp`. You will also want per-image MCS categories
 * (sVirt-style) if you run more than one VM concurrently -- not sketched
 * here.
 */

policy_module(cella, 1.0)

type cella_t;
type cella_exec_t;
domain_type(cella_t)
domain_entry_file(cella_t, cella_exec_t)

# Transition from an interactive shell (unconfined_t on a typical Fedora
# desktop session) into cella_t when executing the labeled binary.
type_transition unconfined_t cella_exec_t : process cella_t;
allow unconfined_t cella_exec_t : file { read execute open getattr map };
allow unconfined_t cella_t : process transition;

# /dev/kvm, /dev/net/tun
allow cella_t kvm_device_t : chr_file { read write open ioctl };
allow cella_t tun_tap_device_t : chr_file { read write open ioctl };

# Freeze-image directories: a dedicated type, NOT user_home_t, so other
# unconfined processes reading a user's home directory don't get to read
# frozen guest state incidentally.
type cella_image_t;
files_type(cella_image_t)
allow cella_t cella_image_t : dir { read write add_name remove_name search getattr };
allow cella_t cella_image_t : file { read write create unlink open getattr };

# Kernel image and disk image, read-only.
type cella_data_t;
files_type(cella_data_t)
allow cella_t cella_data_t : file { read open getattr map };

# No network beyond the TAP fd inherited at exec (no raw socket, no
# unrestricted node/port access) -- deliberately omitted here, add
# corenet rules only if cella ever opens sockets itself. Today it
# doesn't: all guest networking goes through the TAP fd.
